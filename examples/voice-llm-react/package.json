  "dependencies": {
    "@csbc-dev/ami-voice": "^0.1.0",
    "@csbc-dev/ai-agent": "^0.2.0",
    "@wc-bindable/core": "^0.10.0",
    "@wc-bindable/react": "^0.10.0",
    "@wc-bindable/remote": "^0.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
