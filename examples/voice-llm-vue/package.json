    "@wc-bindable/core": "^0.8.0",
    "@wc-bindable/remote": "^0.8.0",
    "@wc-bindable/vue": "^0.8.0",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.3.0"
  }
}
